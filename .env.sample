TZ=Europe/Warsaw

PUID=1000
PGID=1000

# Paths. HDD and SSD data both live on the ZFS pool now; containers still see
# them as /hdd and /ssd, so keep both.
ROOT_APPDATA=/srv/mariusz-box/appdata
ROOT_METADATA=/srv/mariusz-box/metadata
ROOT_DATA_HDD=/mariusz/data
ROOT_DATA_SSD=/mariusz/data
ROOT_MEDIA=/mariusz/data/media
ROOT_SSD=/mariusz/ssd
# qBittorrent's incomplete downloads (a btrfs subvolume on the KIOXIA, no CoW)
ROOT_INCOMPLETE=/srv/mariusz-box/torrent-incomplete

# Shared: the Sure, Lingarr and Paperless databases, and the qBittorrent WebUI
# login decluttarr uses.
PASSWORD={database password}

####### INFRA #######
# Cloudflare token, needs Zone:Zone:Read + Zone:DNS:Edit on januszex.net
# Used by Caddy (DNS-01 certs) and cloudflare-ddns (auto A records)
CF_API_TOKEN={CF_API_TOKEN}
METUBE_PASSWORD_HASH={bcrypt hash from `caddy hash-password`}
# Single-quote it, or compose expands the $ parts of the bcrypt hash.
SEARXNG_PASSWORD_HASH='{bcrypt hash from `caddy hash-password`}'

####### MEDIA / ARR #######
RADARR_API_KEY={RADARR_API_KEY}
SONARR_API_KEY={SONARR_API_KEY}
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY={PROWLARR_API_KEY}
# Streamyfin optimized-versions server
JELLYFIN_URL=https://jellyfin.januszex.net
# Debilarr: Jellyfin Dashboard > API Keys, and SABnzbd Config > General
JELLYFIN_API_KEY={JELLYFIN_API_KEY}
SAB_API_KEY={SAB_API_KEY}

####### SURE #######
# Rails session key for Sure: `openssl rand -hex 64`
SURE_SECRET_KEY_BASE={SURE_SECRET_KEY_BASE}
# Encrypt bank tokens and the Enable Banking key at rest, `openssl rand -hex 16`
# each. Set these before linking a bank; changing them later orphans the data.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY={ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY}
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY={ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY}
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT={ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT}
# Optional, enables Sure's AI categorisation and chat. The model itself is
# chosen in the app (Settings > Providers) — setting it here would override and
# hide that field. OpenRouter slugs use dots, e.g. z-ai/glm-5.2.
OPENROUTER_API_KEY={OPENROUTER_API_KEY}

####### PAPERLESS (profile, off) #######
PAPERLESS_SECRET_KEY={PAPERLESS_SECRET_KEY}

####### IMMICH (profile, off) #######
# The location where your uploaded files are stored
UPLOAD_LOCATION=/mariusz/data/media/photos
# The location where your database files are stored
DB_DATA_LOCATION=/srv/mariusz-box/appdata/immich/postgres
# The Immich version to use. You can pin this to a specific version like "v1.71.0"
IMMICH_VERSION=release
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD={DB_PASSWORD}
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

####### BACKUP (backup/setup.sh, not compose) #######
STORJ_ACCESS_KEY={STORJ_ACCESS_KEY}
STORJ_SECRET_KEY={STORJ_SECRET_KEY}
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_BUCKET=appdata
BACKUP_RETAIN_DAYS="0 1 7 30"
BACKUP_SCHEDULE="*-*-* 05:00:00"
# Optional: Uptime Kuma push monitor URL, pinged up/down after every backup
BACKUP_PUSH_URL=
