{
	servers {
		# All public traffic arrives through Cloudflare: trust its edge ranges
		# so logs, matchers and backends (tinyauth) see the visitor's IP.
		trusted_proxies cloudflare
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

(tls_cf) {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}
	header {
		# Only added when the app doesn't send its own. No X-Frame-Options:
		# czymariuszlezy embeds the Kuma status page in an iframe.
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
	}
}

# Sends the request to tinyauth first; without a session, the visitor lands
# on the login page at auth.januszex.net and comes back after signing in.
(tinyauth) {
	forward_auth tinyauth:3000 {
		uri /api/auth/caddy
	}
}

auth.januszex.net {
	import tls_cf
	reverse_proxy tinyauth:3000
}

januszex.net, jellyfin.januszex.net {
	import tls_cf

	reverse_proxy /Users/ForgotPassword jellyfin:8096
	reverse_proxy /Users/ForgotPassword/Pin jellyfin:8096 {
		header_up X-Forwarded-For 192.168.1.1
	}

	reverse_proxy jellyfin:8096
}

