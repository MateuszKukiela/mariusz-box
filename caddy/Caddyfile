search.januszex.net {
	import tls_cf
	# Browsers fetch address-bar suggestions without the session cookie, so
	# /autocompleter must skip the login or suggestions silently fail. It only
	# returns suggestion strings; results and preferences stay protected.
	@protected not path /autocompleter
	forward_auth @protected tinyauth:3000 {
		uri /api/auth/caddy
	}
	reverse_proxy searxng:8080
}
