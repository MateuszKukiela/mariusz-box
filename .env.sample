TZ=Europe/Warsaw

PUID=1000
PGID=1000

# Paths. The pool's data dataset, seen as /hdd in the containers.
ROOT_APPDATA=/srv/mariusz-box/appdata
ROOT_METADATA=/srv/mariusz-box/metadata
ROOT_DATA_HDD=/mariusz/data
ROOT_MEDIA=/mariusz/data/media
# qBittorrent's incomplete downloads (a btrfs subvolume on the KIOXIA, no CoW)
ROOT_INCOMPLETE=/srv/mariusz-box/torrent-incomplete
# SABnzbd's incomplete folder (a btrfs subvolume on the KIOXIA, no CoW)
ROOT_SAB_INCOMPLETE=/srv/mariusz-box/sabnzbd-incomplete

# Shared: the Sure, Lingarr, Paperless and AFFiNE databases, and the qBittorrent
# WebUI login decluttarr uses, and the fog-map OwnTracks login (user `phone`). AFFiNE puts it in a URL, so no :/@#?% in it.
PASSWORD={database password}

####### INFRA #######
# Cloudflare token, needs Zone:Zone:Read + Zone:DNS:Edit on januszex.net,
# ethangazda.pl and ethangazda.online (or on all zones)
# Used by Caddy (DNS-01 certs) and cloudflare-ddns (auto A records)
CF_API_TOKEN={CF_API_TOKEN}
# tinyauth login (metube, search, portainer, fog): username:bcrypt hash, from
# `docker run --rm -it caddy caddy hash-password` or tinyauth's own tool.
# Single-quote it, or compose expands the $ parts of the hash.
TINYAUTH_USERS='root:{bcrypt hash}'

####### KSIEGOWY (accounting) #######
# See github.com/mateuszkukiela/ksiegowy/.env.example for where each comes from.
KSIEGOWY_FAKTUROWNIA_DOMAIN={fakturownia subdomain}
KSIEGOWY_FAKTUROWNIA_TOKEN={Fakturownia API token}
KSIEGOWY_FAKTUROWNIA_CLIENT_ID={Fakturownia client id}
# true on the real deployment only: pushes each new invoice to KSeF via Fakturownia
KSIEGOWY_FAKTUROWNIA_KSEF_SEND=true
KSIEGOWY_CLIENT_EMAIL={client invoice email}
KSIEGOWY_INVOICE_NAME="Usługi programistyczne (Software Development)"
KSIEGOWY_INVOICE_NET=7500.00
KSIEGOWY_INVOICE_VAT=np
# KSeF basis for the np rate: export_service (client outside the EU) or export_service_eu (EU B2B services)
KSIEGOWY_INVOICE_NP_TAX_KIND=export_service
KSIEGOWY_INVOICE_CURRENCY=USD
KSIEGOWY_INVOICE_LANG=pl/en
KSIEGOWY_INVOICE_PAYMENT_DAYS=14
KSIEGOWY_KSEF_NIP={company NIP}
KSIEGOWY_KSEF_TOKEN={KSeF API token, invoice read rights}
KSIEGOWY_GMAIL_USER={gmail address}
KSIEGOWY_GMAIL_APP_PASSWORD={gmail app password}
KSIEGOWY_ACCOUNTANT_EMAIL={accountant email}
# mBank userscript: random token the script sends as X-Upload-Token (Caddy skips tinyauth for it),
# and the productIds from mBank's history URL
KSIEGOWY_UPLOAD_TOKEN={openssl rand -hex 24}
KSIEGOWY_MBANK_PRODUCT_IDS={659896,937143,659897}

####### MEDIA / ARR #######
RADARR_API_KEY={RADARR_API_KEY}
SONARR_API_KEY={SONARR_API_KEY}
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY={PROWLARR_API_KEY}
# Debilarr: Jellyfin Dashboard > API Keys, and SABnzbd Config > General
JELLYFIN_API_KEY={JELLYFIN_API_KEY}
SAB_API_KEY={SAB_API_KEY}

####### SURE #######
# Rails session key for Sure: `openssl rand -hex 64`
SURE_SECRET_KEY_BASE={SURE_SECRET_KEY_BASE}
# Encrypt bank tokens and the Enable Banking key at rest, `openssl rand -hex 16`
# each. Set these before linking a bank; changing them later orphans the data.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY={ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY}
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY={ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY}
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT={ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT}
# Optional, enables Sure's AI categorisation and chat. The model itself is
# chosen in the app (Settings > Providers) — setting it here would override and
# hide that field. OpenRouter slugs use dots, e.g. z-ai/glm-5.2.
OPENROUTER_API_KEY={OPENROUTER_API_KEY}

####### APPS #######
# Open WebUI session signing key: `openssl rand -hex 32`
OPENWEBUI_SECRET_KEY={OPENWEBUI_SECRET_KEY}

####### PAPERLESS (profile, off) #######
PAPERLESS_SECRET_KEY={PAPERLESS_SECRET_KEY}

####### IMMICH #######
# Originals, uploads and Immich's own DB dumps (on the pool)
UPLOAD_LOCATION=/mariusz/data/media/photos
# Thumbnails: a btrfs subvolume on the KIOXIA, out of snapshots and backups
THUMB_LOCATION=/srv/mariusz-box/immich-thumbs
# Postgres data, on the KIOXIA (no CoW)
DB_DATA_LOCATION=/srv/mariusz-box/appdata/immich/postgres
# Major version to follow; pin like "v3.2.4" to hold an exact release
IMMICH_VERSION=v3
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD={DB_PASSWORD}
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

####### BACKUP (backup/setup.sh, not compose) #######
STORJ_ACCESS_KEY={STORJ_ACCESS_KEY}
STORJ_SECRET_KEY={STORJ_SECRET_KEY}
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_BUCKET=appdata
BACKUP_RETAIN_DAYS="0 1 7 30"
BACKUP_SCHEDULE="*-*-* 05:00:00"
# Optional: Uptime Kuma push monitor URL, pinged up/down after every backup
BACKUP_PUSH_URL=
